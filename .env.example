# Copy to .env on the server. Never commit the real .env file.
PORT=3000
NODE_ENV=production
JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
# Add the exact origin(s) that host your frontend, comma-separated.
# Leave empty when the frontend is served by this same Node application.
ALLOWED_ORIGINS=
# Optional persistent data location on your hosting provider.
DATA_FILE=
