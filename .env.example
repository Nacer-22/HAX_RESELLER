# Copy to .env on the server. Never commit the real .env file.
PORT=3000
NODE_ENV=production
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Required: exact trusted browser origins, comma-separated. Never use *.
ALLOWED_ORIGINS=https://nacer-22.github.io,https://haxpassword-production.up.railway.app,https://haxreseller-production.up.railway.app
# Offerwall.me Placement > Credentials (keep Secret and Bearer Token private)
OFFERWALLME_PUBLIC_API_KEY=
OFFERWALLME_PRIVATE_SECRET=
OFFERWALLME_BEARER_TOKEN=
# Two-letter fallback country when Cloudflare country header is not present (DZ = Algeria)
OFFERWALLME_DEFAULT_COUNTRY=DZ
# Cloudflare Turnstile widget keys
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional persistent data location on your hosting provider.
DATA_FILE=
